# ── Example configuration ───────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values:  cp .env.example .env
# Generate strong secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=development
APP_NAME=LLM Gateway
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ── Secrets — REQUIRED: replace all three before exposing this service ──────
JWT_SECRET=change-me-generate-a-random-48-byte-token
API_KEY_PEPPER=change-me-generate-a-random-48-byte-token
IP_HASH_SALT=change-me-generate-a-random-token
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── Database ────────────────────────────────────────────────────────────────
# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./gateway.db
# PostgreSQL (requires: pip install -r requirements-optional.txt):
# DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
AUTO_CREATE_TABLES=true

# ── Redis (optional — blank uses the in-memory rate limiter) ────────────────
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# ── Upstream provider = YOUR OWN OpenAI (or compatible) account ─────────────
UPSTREAM_PROVIDER=openai
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=sk-your-own-openai-key-here
UPSTREAM_AUTH_MODE=bearer
UPSTREAM_TIMEOUT=120
UPSTREAM_MAX_RETRIES=2

# ── Notrack upstream (anonymous debate API — keyless) ───────────────────────
NOTRACK_BASE_URL=https://notrack.ai
NOTRACK_MODE=usual
NOTRACK_PERSONA=normal
NOTRACK_MAX_TURNS=6

# ── Privacy / logging ───────────────────────────────────────────────────────
LOG_REQUEST_CONTENT=false
LOG_LEVEL=INFO
LOG_JSON=false

# ── Bootstrap admin (optional — seeded on first startup if set) ─────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
